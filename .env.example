# ============================================================
# Enterprise Intelligence Hub - Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- App Mode ---
MOCK_MODE=true          # Set to false to use real AWS/Gmail APIs
DEBUG=false
LOG_LEVEL=INFO
APP_ENV=development     # development | staging | production

# --- AWS Configuration ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_SESSION_TOKEN=                          # Optional: for temporary credentials

# --- AWS Bedrock ---
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_MAX_TOKENS=4096
BEDROCK_TEMPERATURE=0.1
BEDROCK_TOP_P=0.9

# --- Gmail OAuth ---
GMAIL_CLIENT_ID=your-gmail-client-id
GMAIL_CLIENT_SECRET=your-gmail-client-secret
GMAIL_REDIRECT_URI=http://localhost:8501
GMAIL_TOKEN_FILE=token.json
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly,https://www.googleapis.com/auth/calendar.readonly

# --- Application Settings ---
MAX_EMAILS_TO_FETCH=50
EMAIL_FETCH_DAYS=7
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=pdf,docx,xlsx,csv,txt,pptx,png,jpg,jpeg

# --- Knowledge Base ---
KNOWLEDGE_BASE_ID=your-kb-id
KNOWLEDGE_BASE_BUCKET=your-s3-bucket

# --- Security ---
SECRET_KEY=change-me-to-a-random-secret-key-in-production
ALLOWED_ORIGINS=http://localhost:8501

# --- Feature Flags ---
ENABLE_CALENDAR=true
ENABLE_DOCUMENT_ANALYSIS=true
ENABLE_KNOWLEDGE_GRAPH=true
ENABLE_AUDIT_LOG=true
